---
import "../assets/app.css"
import Navbar from "../components/astro/Navbar.astro"
import Card from "../components/react/Card"


---
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Document</title>
</head>
<body class="font-">
  <div class="text-center "><p class="bg-amber-900 text-white p-1">Si tu compra supera los 40$ tu envio sera gratis</p></div>
	
  <Navbar/>

  <!-- Inicio de Carrusel -->
	<div class="carousel h-130 w-full">
  <div id="item1" class="carousel-item w-full">
    <img
      src="https://img.daisyui.com/images/stock/photo-1625726411847-8cbb60cc71e6.webp"
      class="w-full" />
  </div>
  <div id="item2" class="carousel-item w-full">
    <img
      src="https://img.daisyui.com/images/stock/photo-1609621838510-5ad474b7d25d.webp"
      class="w-full" />
  </div>
  <div id="item3" class="carousel-item w-full">
    <img
      src="https://img.daisyui.com/images/stock/photo-1414694762283-acccc27bca85.webp"
      class="w-full" />
  </div>
  <div id="item4" class="carousel-item w-full">
    <img
      src="https://img.daisyui.com/images/stock/photo-1665553365602-b2fb8e5d1707.webp"
      class="w-full" />
  </div>
</div>
<div class="flex w-full justify-center gap-2 py-2">
  <a href="#item1" class="btn btn-xs">1</a>
  <a href="#item2" class="btn btn-xs">2</a>
  <a href="#item3" class="btn btn-xs">3</a>
  <a href="#item4" class="btn btn-xs">4</a>
</div>
<!-- Fin de Carrusel -->

<div class="pt-5 text-left">
  <h1 class="font-bold text-3xl text-gray-900">Classics</h1>
  <p class="text-gray-600 text-lg mt-1">Nuestros Artículos más vendidos</p>
</div>

<!-- Aqui se van a cargar las cards cuando se tenga la Api, la idea es que queden deslizandose a un lado como un carrusel -->
<div>
  <Card/>
</div>





</body>
</html>