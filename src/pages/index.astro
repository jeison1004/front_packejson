---
import "../assets/app.css";
import Carrusel from "../components/astro/Carrusel.astro";
import Layout from "../layouts/Layout.astro";
import Carrusel_productos from "../components/react/Carrusel_productos";

---
  <Layout title="PackeJson" showHeader> 
  <div class="text-center "><p class="bg-amber-900 text-white p-1">Si tu compra supera los 40$ tu envio sera gratis</p></div>
	
  <Carrusel client:load/>

    <div class="p-6 text-left">
      <h2 class="font-bold text-4xl">Classics</h2>
      <p class="text-gray-600 text-lg">Nuestros Artículos más vendidos</p>
    </div>

    <!-- Aqui se van a cargar las cards cuando se tenga la Api, la idea es que queden deslizandose a un lado como un carrusel -->
    <Carrusel_productos client:load/>
    </Layout>

