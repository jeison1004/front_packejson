---
import { FaUserAlt } from "react-icons/fa";
import { MdShoppingCart } from "react-icons/md";
---


<div class="navbar bg-base-100 shadow-sm p-6">
  <div class="flex-1">
    <a class="btn btn-ghost text-xl">PackeJson  </a>
  </div>
  <div class="flex gap-2">
    <input type="text" placeholder="Search" class="input input-bordered rounded-4xl shadow-xl  w-100 xxl:w-auto" />
    <div>
         <div role="button" class="btn btn-ghost btn-circle avatar">
           <FaUserAlt className="w-7 h-7" />
          </div>
         <div role="button" class="btn btn-ghost btn-circle avatar">
           <MdShoppingCart className="w-7 h-7" />
          </div>
    </div>
  </div>
</div>